<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="#060D17" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical" android:padding="6dp">

  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
   android:orientation="horizontal" android:gravity="center_vertical" android:padding="4dp">
   <TextView android:layout_width="0dp" android:layout_height="wrap_content"
    android:layout_weight="1" android:text="SKIN STUDIO 3D"
    android:textColor="#E3F2FD" android:textSize="18sp" android:textStyle="bold"/>
   <TextView android:id="@+id/tvSkinFormatBadge" android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:text="Java / Bedrock"
    android:textColor="#4FC3F7" android:textSize="9sp"/>
  </LinearLayout>

  <RadioGroup android:id="@+id/rgSkinType" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:orientation="horizontal"
   android:background="#0D1E33" android:padding="2dp">
   <RadioButton android:id="@+id/rbClassic" android:layout_width="0dp"
    android:layout_height="36dp" android:layout_weight="1" android:text="Classic (4 px)"
    android:textColor="#E3F2FD" android:buttonTint="#29B6F6" android:textSize="10sp"/>
   <RadioButton android:id="@+id/rbSlim" android:layout_width="0dp"
    android:layout_height="36dp" android:layout_weight="1" android:text="Slim (3 px)"
    android:textColor="#E3F2FD" android:buttonTint="#29B6F6" android:textSize="10sp"/>
  </RadioGroup>

  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:paddingTop="5dp" android:text="VISTA 3D  •  Arrastra para rotar · Pellizca para zoom"
   android:textColor="#81D4FA" android:textSize="10sp" android:textStyle="bold"/>

  <LinearLayout android:layout_width="match_parent" android:layout_height="440dp"
   android:orientation="horizontal" android:gravity="center_vertical">
   <ScrollView android:layout_width="56dp" android:layout_height="match_parent"
    android:scrollbars="none" android:background="#0A192B">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
     android:orientation="vertical" android:gravity="center_horizontal" android:padding="2dp">
     <Button android:id="@+id/btnLoadSkin" android:layout_width="match_parent"
      android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp"
      android:insetTop="0dp" android:insetBottom="0dp" android:padding="1dp"
      android:text="＋ Abrir" android:textSize="7sp" android:backgroundTint="#1565C0"/>
     <Button android:id="@+id/btnPartHead" android:layout_width="match_parent"
      android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp"
      android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
      android:text="Cabeza" android:textSize="7sp"/>
     <Button android:id="@+id/btnPartHair" android:layout_width="match_parent"
      android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp"
      android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
      android:text="Pelo" android:textSize="7sp"/>
     <Button android:id="@+id/btnPartFace" android:layout_width="match_parent"
      android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp"
      android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
      android:text="Cara" android:textSize="7sp"/>
     <Button android:id="@+id/btnPartChest" android:layout_width="match_parent"
      android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp"
      android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
      android:text="Pecho" android:textSize="7sp"/>
     <Button android:id="@+id/btnPartArms" android:layout_width="match_parent"
      android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp"
      android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
      android:text="Brazos" android:textSize="7sp"/>
     <Button android:id="@+id/btnPartHands" android:layout_width="match_parent"
      android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp"
      android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
      android:text="Manos" android:textSize="7sp"/>
     <Button android:id="@+id/btnPartLegs" android:layout_width="match_parent"
      android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp"
      android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
      android:text="Piernas" android:textSize="7sp"/>
     <Button android:id="@+id/btnPartShoes" android:layout_width="match_parent"
      android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp"
      android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
      android:text="Zapatos" android:textSize="7sp"/>
     <Button android:id="@+id/btnFillPart" android:layout_width="match_parent"
      android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp"
      android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
      android:text="▧ Rellenar" android:textSize="7sp"
      android:backgroundTint="#0D47A1"/>
    </LinearLayout>
   </ScrollView>

   <com.forjastudios.skinstudio.SkinViewport3DView
    android:id="@+id/viewport3D" android:layout_width="0dp"
    android:layout_height="match_parent" android:layout_weight="1"
    android:layout_marginHorizontal="3dp"/>

   <LinearLayout android:layout_width="56dp" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:background="#0A192B" android:padding="2dp">
    <Button android:id="@+id/btnBrush" android:layout_width="match_parent"
     android:layout_height="38dp" android:minWidth="0dp" android:minHeight="0dp"
     android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
     android:text="✎ Pincel" android:textSize="7sp" android:backgroundTint="#1565C0"/>
    <Button android:id="@+id/btnBucket" android:layout_width="match_parent"
     android:layout_height="38dp" android:minWidth="0dp" android:minHeight="0dp"
     android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
     android:text="▣ Cubeta" android:textSize="7sp" android:backgroundTint="#1976D2"/>
    <Button android:id="@+id/btnPicker" android:layout_width="match_parent"
     android:layout_height="38dp" android:minWidth="0dp" android:minHeight="0dp"
     android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
     android:text="⌖ Gotero" android:textSize="7sp" android:backgroundTint="#0288D1"/>
    <Button android:id="@+id/btnEraser" android:layout_width="match_parent"
     android:layout_height="38dp" android:minWidth="0dp" android:minHeight="0dp"
     android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
     android:text="⌫ Borrar" android:textSize="7sp" android:backgroundTint="#263B52"/>
    <Button android:id="@+id/btnResetCam" android:layout_width="match_parent"
     android:layout_height="38dp" android:minWidth="0dp" android:minHeight="0dp"
     android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
     android:text="⟳ Vista" android:textSize="7sp" android:backgroundTint="#263B52"/>
    <Button android:id="@+id/btnUniversalWheel" android:layout_width="match_parent"
     android:layout_height="38dp" android:minWidth="0dp" android:minHeight="0dp"
     android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
     android:text="◉ Color" android:textSize="7sp" android:backgroundTint="#0277BD"/>
   </LinearLayout>
  </LinearLayout>

  <TextView android:id="@+id/tvSelectedPart" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:background="#0D1E33"
   android:padding="6dp" android:text="Parte seleccionada: Cabeza"
   android:textColor="#B3E5FC" android:textSize="9sp" android:maxLines="2"/>

  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
   android:orientation="horizontal" android:gravity="center_vertical">
   <TextView android:id="@+id/tvColorInfo" android:layout_width="0dp"
    android:layout_height="wrap_content" android:layout_weight="1"
    android:text="Color activo • #29B6F6" android:textColor="#4FC3F7"
    android:textSize="10sp"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:text="Tamaño" android:textColor="#90CAF9" android:textSize="9sp"/>
   <SeekBar android:id="@+id/seekBrushSize" android:layout_width="100dp"
    android:layout_height="30dp" android:max="8" android:progress="0"
    android:progressTint="#29B6F6" android:thumbTint="#81D4FA"/>
  </LinearLayout>

  <TextView android:id="@+id/tvToolDescription" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:background="#0D1E33"
   android:padding="7dp" android:text="Pincel • Dibuja sobre la textura."
   android:textColor="#B3E5FC" android:textSize="9sp"/>

  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:paddingTop="7dp" android:text="PALETA DE COLORES"
   android:textColor="#81D4FA" android:textSize="10sp" android:textStyle="bold"/>
  <HorizontalScrollView android:id="@+id/hsvPaletteScroll"
   android:layout_width="match_parent" android:layout_height="36dp"
   android:scrollbars="none"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:paddingTop="6dp" android:text="✦ TEXTURA 2D"
   android:textColor="#81D4FA" android:textSize="10sp" android:textStyle="bold"/>
  <com.forjastudios.skinstudio.SkinTextureEditorView
   android:id="@+id/textureEditor" android:layout_width="match_parent"
   android:layout_height="190dp" android:layout_marginTop="3dp"/>
 </LinearLayout>
</ScrollView>